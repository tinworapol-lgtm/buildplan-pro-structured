SUPABASE_SERVICE_ROLE_KEY=

# Public beta admin/readiness
BETA_ADMIN_TOKEN=
BETA_TRIAL_DAYS=90
BETA_PROJECT_LIMIT=10
BETA_PROJECT_PAYLOAD_BYTES=750000
